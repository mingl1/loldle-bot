DISCORD_APPLICATION_ID=your_application_id
DISCORD_PUBLIC_KEY=your_public_key
# Required to edit/create the sticky daily progress board in-channel
DISCORD_TOKEN=your_bot_token
# Convex HTTP site URL (https://<deployment>.convex.site) — no trailing slash needed
PROGRESS_API_BASE_URL=https://your-deployment.convex.site
# Shared secret; must match PROGRESS_API_SECRET in the Convex deployment env.
# Also used as Bearer auth for POST /sync-progress on this worker.
PROGRESS_API_SECRET=replace_me
# Optional JSON array of ms delays to re-sync the board after /loldle (default [2500,7000,15000,25000]).
# Set to [] to disable. For live mid-game updates, Convex should POST /sync-progress after guesses.
# PROGRESS_LAUNCH_REFRESH_DELAYS_MS=[2500,7000,15000,25000]
