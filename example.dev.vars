DISCORD_APPLICATION_ID=your_application_id
DISCORD_PUBLIC_KEY=your_public_key
# Required to edit/create the sticky daily progress board in-channel
DISCORD_TOKEN=your_bot_token
# Convex HTTP site URL (https://<deployment>.convex.site) — no trailing slash needed
PROGRESS_API_BASE_URL=https://your-deployment.convex.site
# Shared secret; must match PROGRESS_API_SECRET in the Convex deployment env.
# Also used as Bearer auth for POST /sync-progress on this worker.
PROGRESS_API_SECRET=replace_me
# Optional JSON array of absolute ms-from-launch times to re-sync the board after
# /loldle or Play (default [1500,3500,7000,12000,20000,30000]). Set to [] to disable.
# PROGRESS_LAUNCH_REFRESH_DELAYS_MS=[1500,3500,7000,12000,20000,30000]
# Optional absolute ms-from-sync follow-ups after POST /sync-progress (default
# [500,2000,5000]). Helps finishes land if the Activity closes immediately.
# For live updates, Convex should POST /sync-progress after guesses AND on solve
# (prefer a Convex scheduler/action, not a browser fetch that dies on exit).
# PROGRESS_SYNC_REFRESH_DELAYS_MS=[500,2000,5000]
#
# Clickable board names need the Activity companion patch in
# vendor/loldle-activity-patch (SHARE_CHANNEL_ID on the Activity, plus
# stringName / discordName / shareImageUrl on /channel-progress players).
