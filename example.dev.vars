DISCORD_APPLICATION_ID=your_application_id
DISCORD_PUBLIC_KEY=your_public_key
DISCORD_TOKEN=your_bot_token
# Convex HTTP site URL (https://<deployment>.convex.site) — no trailing slash needed
PROGRESS_API_BASE_URL=https://your-deployment.convex.site
# Shared secret; must match PROGRESS_API_SECRET in the Convex deployment env
PROGRESS_API_SECRET=replace_me
