index 26d0abb..1ef3930 100644
--- a/env.d.ts
+++ b/env.d.ts
@@ -9,6 +9,7 @@ declare global {
 			NODE_OPTIONS: string
 			PORT: string
 			DISCORD_TOKEN: string
+			SHARE_CHANNEL_ID: string
 		}
 	}
 }
diff --git a/src/api/share.ts b/src/api/share.ts
index b68bb74..12b8865 100644
--- a/src/api/share.ts
+++ b/src/api/share.ts
@@ -1,12 +1,18 @@
 import type { RoboRequest } from '@robojs/server'
 
+/**
+ * Host a share PNG on Discord CDN by posting it to a private bot channel.
+ * Returns the attachment URL for board links / share-moment dialogs.
+ * Does not DM the user.
+ */
 export default async (req: RoboRequest) => {
 	const formData = await req.formData()
 	const image = formData.get('image') as File | null
+	// Optional — used only for logging / filename context
 	const userId = formData.get('userId') as string | null
 
-	if (!image || !userId) {
-		return new Response(JSON.stringify({ error: 'Missing image or userId' }), { status: 400 })
+	if (!image) {
+		return new Response(JSON.stringify({ error: 'Missing image' }), { status: 400 })
 	}
 
 	const botToken = process.env.DISCORD_TOKEN
@@ -14,29 +20,22 @@ export default async (req: RoboRequest) => {
 		return new Response(JSON.stringify({ error: 'DISCORD_TOKEN not configured' }), { status: 500 })
 	}
 
-	// Open (or reuse) a DM channel with the user
-	const dmRes = await fetch('https://discord.com/api/v10/users/@me/channels', {
-		method: 'POST',
-		headers: {
-			Authorization: `Bot ${botToken}`,
-			'Content-Type': 'application/json',
-		},
-		body: JSON.stringify({ recipient_id: userId }),
-	})
-
-	if (!dmRes.ok) {
-		const err = await dmRes.text()
-		return new Response(JSON.stringify({ error: `DM channel error: ${err}` }), { status: 500 })
+	const shareChannelId = process.env.SHARE_CHANNEL_ID
+	if (!shareChannelId) {
+		return new Response(JSON.stringify({ error: 'SHARE_CHANNEL_ID not configured' }), { status: 500 })
 	}
 
-	const { id: dmChannelId } = (await dmRes.json()) as { id: string }
-
-	// Upload the image to that DM channel as a message attachment
+	const filename = userId ? `loldle-result-${userId}.png` : 'loldle-result.png'
 	const msgForm = new FormData()
-	msgForm.append('payload_json', JSON.stringify({ content: '' }))
-	msgForm.append('files[0]', image, 'loldle-result.png')
-
-	const msgRes = await fetch(`https://discord.com/api/v10/channels/${dmChannelId}/messages`, {
+	msgForm.append(
+		'payload_json',
+		JSON.stringify({
+			content: userId ? `Share image for <@${userId}>` : '',
+		}),
+	)
+	msgForm.append('files[0]', image, filename)
+
+	const msgRes = await fetch(`https://discord.com/api/v10/channels/${shareChannelId}/messages`, {
 		method: 'POST',
 		headers: { Authorization: `Bot ${botToken}` },
 		body: msgForm,
diff --git a/src/app/Activity4.tsx b/src/app/Activity4.tsx
index 935e8a1..f2d06fa 100644
--- a/src/app/Activity4.tsx
+++ b/src/app/Activity4.tsx
@@ -432,9 +432,15 @@ export const Activity4 = () => {
 	const guessPulseTimer = useRef<number | null>(null)
 	const headerRef = useRef<HTMLElement | null>(null)
 	const headerHeightRef = useRef(HEADER_HEIGHT_FALLBACK)
+	const lastShareSyncRef = useRef<string | null>(null)
 	const { authenticated, session, discordSdk } = useDiscordSdk()
 	const userId = authenticated ? (session?.user?.id ?? null) : null
-	const username = authenticated ? (session?.user?.username ?? 'Unknown') : null
+	const discordName = authenticated ? (session?.user?.username ?? 'Unknown') : null
+	const stringName = authenticated
+		? (session?.user?.global_name || session?.user?.username || 'Unknown')
+		: null
+	/** @deprecated peer rail / legacy progress field — prefer stringName */
+	const username = stringName
 	const channelId = discordSdk.channelId
 	const dateKey = getDailyDateKey()
 	const dailyTarget = useQuery(api.dailyTarget.getByDate, { dateKey })
@@ -534,16 +540,46 @@ export const Activity4 = () => {
 		guessPulseTimer.current = window.setTimeout(() => setGuessPulse(false), 650)
 	}
 
-	const syncChannelProgress = (guessCount: number, solved: boolean) => {
-		if (!userId || !username || !channelId) return
-		void upsertChannelProgress({
-			channelId,
-			dateKey,
-			userId,
-			username,
-			guessCount,
-			solved
-		})
+	const uploadShareImage = async (rows: GuessRow[]): Promise<string | null> => {
+		if (!rows.length) return null
+		try {
+			const blob = await generateShareImage({ guesses: rows })
+			const form = new FormData()
+			form.append('image', blob, 'loldle-result.png')
+			if (userId) form.append('userId', userId)
+			const res = await fetch('/.proxy/api/share', { method: 'POST', body: form })
+			if (!res.ok) throw new Error(await res.text())
+			const { url } = (await res.json()) as { url: string }
+			return url || null
+		} catch (err) {
+			console.error('Share image upload failed:', err)
+			return null
+		}
+	}
+
+	const syncChannelProgress = (
+		guessCount: number,
+		solved: boolean,
+		rows: GuessRow[] = guesses,
+	) => {
+		if (!userId || !stringName || !discordName || !channelId) return
+		const signature = `${guessCount}:${solved}:${rows.map((row) => row.champion.id).join(',')}`
+		if (lastShareSyncRef.current === signature) return
+		lastShareSyncRef.current = signature
+		void (async () => {
+			const shareImageUrl = guessCount > 0 ? await uploadShareImage(rows) : null
+			void upsertChannelProgress({
+				channelId,
+				dateKey,
+				userId,
+				username: stringName,
+				stringName,
+				discordName,
+				guessCount,
+				solved,
+				...(shareImageUrl ? { shareImageUrl } : {}),
+			})
+		})()
 	}
 
 	useEffect(() => {
@@ -635,7 +671,8 @@ export const Activity4 = () => {
 			void saveState({ userId, targetId: targetRef.current.id, guessIds: nextGuesses.map((row) => row.champion.id) })
 		syncChannelProgress(
 			nextGuesses.length,
-			nextGuesses.some((row) => row.champion.id === targetRef.current?.id)
+			nextGuesses.some((row) => row.champion.id === targetRef.current?.id),
+			nextGuesses,
 		)
 		setQuery('')
 	}
